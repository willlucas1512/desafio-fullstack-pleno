# Variáveis do docker-compose. Os serviços leem este arquivo via `env_file`,
# então `docker compose up` já funciona sem setup. Para sobrescrever, copie
# (`cp .env.example .env`) e ajuste — o `.env` é opcional e tem prioridade.

# --- Postgres (persistência das revisões) ---
POSTGRES_USER=painel
POSTGRES_PASSWORD=painel
POSTGRES_DB=painel

# --- API ---
# Aponta pro serviço `postgres` da rede do compose (não localhost).
DATABASE_URL=postgres://painel:painel@postgres:5432/painel
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:3000
# Credenciais aceitas pela API (do enunciado).
TECHNICIAN_EMAIL=tecnico@prefeitura.rio
TECHNICIAN_PASSWORD=painel@2024

# --- Web ---
# URL pública da API consumida pelo browser (porta do host).
NEXT_PUBLIC_API_URL=http://localhost:3001
# Botão de demo no login: vazio = sem botão. Preencha pra pré-popular o login
# (reaproveite as credenciais do técnico acima). Em produção, deixe em branco.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=

# --- Portas expostas no host ---
API_HOST_PORT=3001
WEB_HOST_PORT=3000
