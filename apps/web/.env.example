# URL da API, usada SOMENTE no servidor (BFF): os Route Handlers em /api/* e o
# middleware falam com a API por aqui. Sem prefixo NEXT_PUBLIC_ de propósito —
# o browser nunca acessa a API direto, só o proxy same-origin /api/proxy.
API_URL=http://localhost:3001

# Credenciais de demonstração exibidas na tela de login (opcional).
# Defina ambas para mostrar o box de "Credenciais de teste"; deixe em branco em produção.
NEXT_PUBLIC_DEMO_EMAIL=tecnico@prefeitura.rio
NEXT_PUBLIC_DEMO_PASSWORD=painel@2024
