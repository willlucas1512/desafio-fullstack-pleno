# defaults do docker-compose batem com o enunciado, entao `docker compose up`
# funciona sem precisar copiar esse arquivo. Use isso aqui se quiser rodar
# a API direto com Node ou sobrescrever algum valor.

PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Segredo de DEV (>= 16 chars). Fixo p/ tokens sobreviverem a restart e serem
# compartilhados entre instâncias. Troque por um segredo forte em produção.
JWT_SECRET=dev-shared-jwt-secret-troque-em-producao-0a1b2c3d4e5f
JWT_EXPIRES_IN=1h

# credenciais aceitas pela API (do enunciado)
TECHNICIAN_EMAIL=tecnico@prefeitura.rio
TECHNICIAN_PASSWORD=painel@2024

CORS_ORIGIN=http://localhost:3000
SEED_FILE=../../data/seed.json

# Postgres é a única fonte de estado: schema e seed são criados no boot.
# Obrigatória (sem default no código). No docker-compose ela vem do `env_file`;
# no dev local, defina aqui apontando pro seu banco. Formato:
# DATABASE_URL=postgres://USUARIO:SENHA@localhost:5432/NOME_DO_BANCO
